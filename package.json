{
  "name": "classding",
  "private": true,
  "version": "0.3.5",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @classding/teacher dev",
    "dev:admin": "pnpm --filter @classding/admin dev",
    "dev:screen": "pnpm --filter @classding/screen dev",
    "dev:server": "node scripts/dev-server.mjs",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "check:toolchain": "node scripts/check-toolchain.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run screen/frontend/tests web/apps/admin/src/*.test.ts web/apps/teacher/src/*.test.ts",
    "test:e2e": "playwright test",
    "api:generate": "node scripts/generate-contract.mjs && pnpm --filter @classding/api-generator generate",
    "prepare:static": "node scripts/prepare-static.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@tanstack/react-query": "5.107.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.70.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "recharts": "3.10.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  }
}
