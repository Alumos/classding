DOMAIN=classding.example.com
CLASSDING_IMAGE=ghcr.io/alumos/classding-server:v0.1.0
# openssl rand -hex 32
JWT_SECRET=
# 128位以上Base32密钥；导入OTP认证器（首次登录即要求验证码）
ADMIN_TOTP_SECRET=
# 仅首次部署设置；创建成功后清空用户名/密码并重新创建容器
BOOTSTRAP_ADMIN_USERNAME=alumos
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=管理员
SENSITIVE_WORDS=
